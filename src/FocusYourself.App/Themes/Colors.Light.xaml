<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 亮色主题配色。键名必须与 Colors.Dark.xaml 完全一致 -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFECEEF2" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceHiBrush" Color="#FFEDEFF3" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E3E8" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1F2329" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF5B6270" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FF8A919C" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FFEE5440" />
    <SolidColorBrush x:Key="BreakBrush" Color="#FF239B63" />
    <SolidColorBrush x:Key="LongBreakBrush" Color="#FF3474D9" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFC97A0E" />
    <SolidColorBrush x:Key="FocusSoftBrush" Color="#1FEE5440" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#14C97A0E" />
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#40C97A0E" />
    <SolidColorBrush x:Key="BreakSoftBrush" Color="#1A239B63" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0B000000" />
    <SolidColorBrush x:Key="PressBrush" Color="#16000000" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#08000000" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#14000000" />
    <SolidColorBrush x:Key="RingTrackBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#FFD3D7DE" />
    <SolidColorBrush x:Key="KnobOffBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2E000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4D000000" />
    <SolidColorBrush x:Key="OverlayBgBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#33EE5440" />
    <SolidColorBrush x:Key="RingInnerBrush" Color="#12EE5440" />
    <RadialGradientBrush x:Key="PopupBgBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.1" RadiusY="0.9">
        <GradientStop Color="#FFFFECE8" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="0.6" />
        <GradientStop Color="#FFFBFBFC" Offset="1" />
    </RadialGradientBrush>
    <Color x:Key="ShadowColor">#FF20242C</Color>
    <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="ShadowOpacity">0.18</system:Double>
</ResourceDictionary>
