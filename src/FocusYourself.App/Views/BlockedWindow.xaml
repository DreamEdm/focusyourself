<Window x:Class="FocusYourself.Views.BlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FocusYourself.Views"
        xmlns:l="clr-namespace:FocusYourself.Views"
        Title="FocusYourself" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Width="500" SizeToContent="Height" FontFamily="{StaticResource UiFont}" Opacity="0">
    <Border x:Name="Card" Margin="28" CornerRadius="26" BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}"
            Background="{DynamicResource PopupBgBrush}" TextElement.Foreground="{DynamicResource TextBrush}"
            RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="0.92" ScaleY="0.92" />
        </Border.RenderTransform>
        <Grid>
            <StackPanel Margin="40,40,40,30" HorizontalAlignment="Center">
                <!-- 环形倒计时 + 被拦截程序的图标 -->
                <Grid Width="156" Height="156" HorizontalAlignment="Center">
                    <Ellipse Margin="18" Fill="{DynamicResource RingInnerBrush}" />
                    <v:ProgressRing x:Name="Ring" Thickness="7" RingBrush="{StaticResource FocusGradient}" TrackBrush="{DynamicResource RingTrackBrush}" />
                    <Grid x:Name="Breath" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Image x:Name="AppIcon" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="FallbackGlyph" Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="44" Foreground="{DynamicResource FocusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <!-- 右下角的“禁止”角标 -->
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource FocusBrush}" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="3"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Dim}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" />

                <Border x:Name="TimePill" CornerRadius="14" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                        Padding="22,12" Margin="0,22,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T UntilBreak}" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="TimeText" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="QuestionText" Text="{l:T FolderQuestion}" FontSize="14" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,22,0,0" Visibility="Collapsed" />

                <TextBlock x:Name="QuoteText" FontSize="13" FontStyle="Italic" Foreground="{DynamicResource TextFaintBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="OpenAppButton" Content="{l:T OpenFocusYourself}" Margin="0,0,10,0" Visibility="Collapsed" Click="OnOpenApp" />
                    <Button x:Name="OkButton" Style="{StaticResource BigButton}" Click="OnOk" />
                    <Button x:Name="ContinueButton" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="OnContinue" />
                </StackPanel>
            </StackPanel>
            <Border x:Name="Life" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="26,0,26,12" Background="{DynamicResource FocusBrush}" Opacity="0.35" />
        </Grid>
    </Border>
</Window>
