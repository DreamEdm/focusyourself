<Window x:Class="FocusYourself.Views.SmartBlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FocusYourself.Views"
        Title="FocusYourself" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Width="640" Height="720" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- 小方框勾选 -->
        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource TextFaintBrush}" Background="Transparent">
                                <Grid>
                                    <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <Border x:Name="Dash" Width="8" Height="2" CornerRadius="1" Background="White" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="24" CornerRadius="22" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <DockPanel Margin="30,28,30,24">
            <!-- 标题 -->
            <DockPanel DockPanel.Dock="Top">
                <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource FocusSoftBrush}" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="20" Foreground="{DynamicResource FocusBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T SmartTitle}" Style="{StaticResource H2}" FontSize="20" />
                    <TextBlock Text="{l:T SmartSubtitle}" Style="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- 说明三点 -->
            <Border DockPanel.Dock="Top" Margin="0,20,0,0" CornerRadius="14" Padding="16,14" Background="{DynamicResource SubtleBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="14" Foreground="{DynamicResource BreakBrush}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{l:T SmartNotice1}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{l:T SmartNotice2}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE916;" FontSize="14" Foreground="{DynamicResource LongBreakBrush}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{l:T SmartNotice3}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 底部按钮 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock x:Name="CountText" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T Cancel}" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="150" Click="OnConfirm" IsEnabled="False" />
                </StackPanel>
            </DockPanel>

            <!-- 分类清单 -->
            <Border Margin="0,18,0,0" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6">
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="16,8,16,6">
                                    <DockPanel Margin="0,4,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                        <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding AllChecked}" IsThreeState="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="14" Foreground="{DynamicResource FocusBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="30,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsChecked}" Margin="0,5" ToolTip="{Binding Detail}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>
