<Window x:Class="FocusYourself.Views.ExtensionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FocusYourself.Views"
        xmlns:vm="clr-namespace:FocusYourself.ViewModels"
        Title="FocusYourself" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Width="640" Height="680" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepNo" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource FocusSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- 已连接 / 不支持 的小标签 -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </Window.Resources>

    <Border Margin="24" CornerRadius="22" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <Grid Margin="30,28,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,-8,-10,0"
                        Content="&#xE8BB;" ToolTip="{l:T Close}" Command="{Binding CloseCommand}" />
                <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource FocusSoftBrush}" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA86;" FontSize="20" Foreground="{DynamicResource FocusBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T SetupTitle}" Style="{StaticResource H2}" FontSize="20" />
                    <TextBlock Text="{l:T SetupSubtitle}" Style="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- ============ 第一步：选择浏览器 ============ -->
            <DockPanel Grid.Row="1" Margin="0,20,0,0" Visibility="{Binding IsChoosePage, Converter={StaticResource BoolToVis}}">
                <Border DockPanel.Dock="Top" CornerRadius="14" Padding="16,14" Background="{DynamicResource SubtleBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Foreground="{DynamicResource LongBreakBrush}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{l:T SetupNotice}" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T SetupAddBrowser}" Click="OnAddBrowser" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="{l:T Cancel}" Command="{Binding CloseCommand}" IsCancel="True" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="150" Content="{Binding StartText}"
                                Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" IsDefault="True" />
                    </StackPanel>
                </DockPanel>

                <Border Margin="0,18,0,0" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6">
                            <ItemsControl ItemsSource="{Binding Browsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,9" Background="Transparent" ToolTip="{Binding Path}">
                                            <DockPanel>
                                                <Border x:Name="ConnectedBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource BreakSoftBrush}" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="10" Foreground="{DynamicResource BreakBrush}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{l:T SetupConnected}" FontSize="11" Foreground="{DynamicResource BreakBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="UnsupportedBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource SubtleBrush}"
                                                        Visibility="{Binding Unsupported, Converter={StaticResource BoolToVis}}" ToolTip="{l:T SetupUnsupportedTip}">
                                                    <TextBlock Text="{l:T SetupUnsupported}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                                                </Border>
                                                <CheckBox x:Name="Pick" Style="{StaticResource Tick}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding Supported}">
                                                    <DockPanel>
                                                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SubtleBrush}" Margin="0,0,12,0">
                                                            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </CheckBox>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter TargetName="ConnectedBadge" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Supported}" Value="False">
                                                <Setter TargetName="Pick" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{l:T SetupNoBrowsers}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="30"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBrowsers}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ============ 第二步：逐个浏览器安装 ============ -->
            <DockPanel Grid.Row="1" Margin="0,20,0,0" Visibility="{Binding IsInstallPage, Converter={StaticResource BoolToVis}}">
                <!-- 进度条：每个浏览器一个小标签 -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Queue}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Chip" CornerRadius="10" Padding="10,5" Margin="0,0,8,8" BorderThickness="1"
                                    Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,7,0" />
                                    <TextBlock x:Name="ChipText" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChipMark" Style="{StaticResource Icon}" FontSize="10" Margin="7,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Active}">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource FocusSoftBrush}" />
                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Connected}">
                                    <Setter TargetName="ChipMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ChipMark" Property="Text" Value="&#xE73E;" />
                                    <Setter TargetName="ChipMark" Property="Foreground" Value="{DynamicResource BreakBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Skipped}">
                                    <Setter TargetName="ChipMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ChipMark" Property="Text" Value="&#xE711;" />
                                    <Setter TargetName="ChipMark" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T SetupBack}" Command="{Binding BackCommand}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="{l:T SetupSkip}" Command="{Binding SkipCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="120" Content="{Binding NextText}" Command="{Binding NextCommand}" />
                    </StackPanel>
                </DockPanel>

                <!-- 等待连接的状态条 -->
                <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" CornerRadius="12" Padding="14,11" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BreakSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BreakBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse x:Name="Pulse" Width="8" Height="8" Fill="{DynamicResource WarnBrush}" Margin="2,0,12,0" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{Binding WaitingText}" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CurrentConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="{DynamicResource BreakBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{l:T SetupDetected}" Foreground="{DynamicResource BreakBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding InstallTitle}" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding StepOfText}" Style="{StaticResource Faint}" Margin="0,3,0,18" />

                        <!-- 1. 打开扩展页 -->
                        <DockPanel Margin="0,0,0,16">
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FocusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="{Binding OpenText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StepText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OpenFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="{l:T SetupReopen}" Command="{Binding OpenPageCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{l:T SetupCopyUrl}" Margin="8,0,0,0" Command="{Binding CopyUrlCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- 2. 开发者模式 -->
                        <DockPanel Margin="0,0,0,16">
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FocusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding DevModeText}" Style="{StaticResource StepText}" />
                        </DockPanel>

                        <!-- 3. 拖入文件夹 -->
                        <DockPanel Margin="0,0,0,16">
                            <Border Style="{StaticResource StepNo}"><TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FocusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="{l:T SetupStep3}" Style="{StaticResource StepText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="{l:T OpenFolder}" Command="{Binding RevealFolderCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{l:T CopyPath}" Margin="8,0,0,0" Command="{Binding CopyFolderPathCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- 4. 无痕（可选） -->
                        <DockPanel>
                            <Border Style="{StaticResource StepNo}" Background="{DynamicResource SubtleBrush}"><TextBlock Text="4" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{l:T SetupStep4}" Style="{StaticResource StepText}" Foreground="{DynamicResource TextDimBrush}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ============ 第三步：完成 ============ -->
            <DockPanel Grid.Row="1" Margin="0,20,0,0" Visibility="{Binding IsDonePage, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T SetupBack}" Command="{Binding BackCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="120" Content="{l:T SetupFinish}" Command="{Binding CloseCommand}" />
                </DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BreakSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="30" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllConnected}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{DynamicResource BreakBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding DoneTitle}" Style="{StaticResource H2}" FontSize="20" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding DoneText}" Style="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="0,8,0,22" />
                    <ItemsControl ItemsSource="{Binding Queue}" HorizontalAlignment="Center" MinWidth="320">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="{DynamicResource SubtleBrush}" Padding="14,9" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock x:Name="State" DockPanel.Dock="Right" Text="{l:T SetupNotConnected}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter TargetName="State" Property="Text" Value="{l:T SetupConnected}" />
                                        <Setter TargetName="State" Property="Foreground" Value="{DynamicResource BreakBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
