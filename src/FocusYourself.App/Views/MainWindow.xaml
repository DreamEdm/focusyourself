<Window x:Class="FocusYourself.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FocusYourself.Views"
        xmlns:l="clr-namespace:FocusYourself.Views"
        Title="FocusYourself" Width="1080" Height="740" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 侧边栏底部的小切换按钮（主题 / 语言） -->
        <Style x:Key="SideToggle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="10,8" Background="{DynamicResource SubtleBrush}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 圆环中间可直接编辑的时长：平时和普通数字一样，悬停出现下划线和铅笔，编辑时只显示分钟数 -->
        <Style x:Key="TimeEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="72" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource FocusBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource FocusBrush}" />
            <Setter Property="SelectionOpacity" Value="0.3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContextMenu" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            <Border x:Name="Underline" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="6,0,6,6" Background="Transparent" />
                            <!-- 不占布局的右侧标注，数字保持居中 -->
                            <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock x:Name="Pencil" Canvas.Left="10" Canvas.Top="-9" Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="18" FontWeight="Normal" Foreground="{DynamicResource TextFaintBrush}" Opacity="0" />
                                <TextBlock x:Name="Unit" Canvas.Left="10" Canvas.Top="6" Text="{l:T MinutesUnit}" FontFamily="{StaticResource UiFont}"
                                           FontSize="18" FontWeight="Normal" Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource RingTrackBrush}" />
                                <Setter TargetName="Pencil" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Pencil" Property="Opacity" Value="0" />
                                <Setter TargetName="Unit" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource TextBrush}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- ============ 侧边栏 ============ -->
                        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                            <DockPanel Margin="16,18,16,18">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,0,30">
                                    <Viewbox Width="36" Height="36">
                                        <Grid Width="32" Height="32">
                                            <Path Data="{x:Static v:TomatoShape.Body}" Fill="{StaticResource TomatoBodyBrush}" />
                                            <Ellipse Width="6.6" Height="4.8" Margin="6.6,12.4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#50FFFFFF" />
                                            <Path Data="{x:Static v:TomatoShape.Leaf}" Fill="{StaticResource TomatoLeafBrush}" />
                                        </Grid>
                                    </Viewbox>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="FocusYourself" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{l:T AppTagline}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 底部状态 -->
                                <Border DockPanel.Dock="Bottom" CornerRadius="12" Background="{DynamicResource SubtleBrush}" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExtensionConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource BreakBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ExtensionStatus}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                                       ToolTip="{Binding ExtensionStatus}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AdminStatus}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="15,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 主题 / 语言切换 -->
                                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,0,0,10">
                                    <Button Style="{StaticResource SideToggle}" Margin="0,0,5,0" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding ThemeIcon}" FontSize="13" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding ThemeLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SideToggle}" Margin="5,0,0,0" Command="{Binding ToggleLanguageCommand}" ToolTip="{l:T LanguageToggleTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xF2B7;" FontSize="13" Margin="0,0,7,0" />
                                            <TextBlock Text="{l:T LanguageName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <StackPanel IsItemsHost="True" />
                            </DockPanel>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ======================= 番茄钟 ======================= -->
            <TabItem Header="{l:T NavPomodoro}" Tag="&#xE916;" Style="{StaticResource NavItem}">
                <Grid Margin="44,52,44,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:T NavPomodoro}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding HintText}" Style="{StaticResource Dim}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- 首次使用：智能拦截引导 -->
                    <Border Grid.Row="1" Margin="0,18,0,0" CornerRadius="14" Padding="18,14" BorderThickness="1"
                            Background="{DynamicResource FocusSoftBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                            Visibility="{Binding ShowSmartBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE945;" FontSize="22" Foreground="{DynamicResource FocusBrush}" Margin="0,0,14,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="30" Height="30" FontSize="11" Content="&#xE8BB;" Margin="8,0,0,0"
                                    ToolTip="{l:T SmartBannerDismiss}" Command="{Binding DismissSmartBannerCommand}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T SmartBannerAction}" Command="{Binding OpenSmartBlockCommand}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{l:T SmartBannerTitle}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{l:T SmartBannerBody}" Style="{StaticResource Dim}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,12,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="320" Height="320">
                            <Ellipse Margin="34" Fill="{Binding PhaseBrush}" Opacity="0.06" />
                            <v:ProgressRing Thickness="12" Progress="{Binding Progress}" RingBrush="{Binding PhaseBrush}" TrackBrush="{DynamicResource RingTrackBrush}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PhaseLabel}" Foreground="{Binding PhaseBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <Grid HorizontalAlignment="Center" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}" FontSize="72" FontWeight="Light"
                                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"
                                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                    <!-- 空闲时可以直接点数字改专注时长（只填分钟），滚轮或 ↑↓ 每次加减 1 分钟 -->
                                    <TextBox x:Name="TimeEditor" Style="{StaticResource TimeEditor}" ToolTip="{l:T TimeEditTip}"
                                             Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"
                                             PreviewMouseLeftButtonDown="OnTimeEditorMouseDown" GotKeyboardFocus="OnTimeEditorGotFocus"
                                             LostKeyboardFocus="OnTimeEditorLostFocus" PreviewKeyDown="OnTimeEditorKeyDown"
                                             PreviewTextInput="OnTimeEditorTextInput" PreviewMouseWheel="OnTimeEditorWheel" />
                                </Grid>
                                <TextBlock Text="{Binding RoundText}" Style="{StaticResource Faint}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 一组番茄的进度：吃完的是红番茄，正在专注的那颗从下往上慢慢变红，还没开始的是灰色 -->
                        <ItemsControl ItemsSource="{Binding RoundDots}" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Viewbox Width="24" Height="24" Margin="4,0" ToolTip="{Binding Tip}">
                                        <Grid Width="32" Height="32" Background="Transparent">
                                            <Path Data="{x:Static v:TomatoShape.Body}" Fill="{DynamicResource RingTrackBrush}" />
                                            <!-- 已完成的部分：整颗番茄画好后只露出底部 FillHeight 那一截 -->
                                            <Grid VerticalAlignment="Bottom" Height="{Binding FillHeight}" ClipToBounds="True">
                                                <Grid Width="32" Height="32" VerticalAlignment="Bottom">
                                                    <Path Data="{x:Static v:TomatoShape.Body}" Fill="{StaticResource TomatoBodyBrush}" />
                                                    <Ellipse Width="6.6" Height="4.8" Margin="6.6,12.4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#50FFFFFF" />
                                                </Grid>
                                            </Grid>
                                            <Path x:Name="Outline" Data="{x:Static v:TomatoShape.Body}" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1.8" Visibility="Collapsed" />
                                            <Path x:Name="Leaf" Data="{x:Static v:TomatoShape.Leaf}" Fill="{DynamicResource RingTrackBrush}" />
                                        </Grid>
                                    </Viewbox>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="Leaf" Property="Fill" Value="{StaticResource TomatoLeafBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                            <Setter TargetName="Leaf" Property="Fill" Value="{StaticResource TomatoLeafBrush}" />
                                            <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 操作按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource BigButton}" Content="{l:T StartFocus}" Command="{Binding StartFocusCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:T BreakFirst}" Margin="12,0,0,0" Command="{Binding StartBreakCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFocusActions, Converter={StaticResource BoolToVis}}">
                                <Button Content="{l:T SkipToBreak}" Command="{Binding SkipCommand}" />
                                <Button Content="{l:T Pause}" Margin="10,0,0,0" Command="{Binding TogglePauseCommand}" ToolTip="{l:T PauseTip}" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:T Stop}" Margin="10,0,0,0" Command="{Binding StopCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowBreakActions, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource BigButton}" Content="{l:T FocusEarly}" Command="{Binding SkipCommand}" />
                                <Button Content="{l:T Pause}" Margin="10,0,0,0" Command="{Binding TogglePauseCommand}" ToolTip="{l:T PauseTip}" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:T Stop}" Margin="10,0,0,0" Command="{Binding StopCommand}" />
                            </StackPanel>
                            <!-- 暂停中：只留“继续”和“停止” -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource BigButton}" Content="{l:T Resume}" Command="{Binding TogglePauseCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:T Stop}" Margin="12,0,0,0" Command="{Binding StopCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 严格模式冷静期 -->
                        <Border Visibility="{Binding StrictPending, Converter={StaticResource BoolToVis}}" Margin="0,22,0,0" CornerRadius="14"
                                Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" Padding="18,14" MaxWidth="460">
                            <StackPanel>
                                <TextBlock Text="{Binding StrictText}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T KeepFocusing}" Command="{Binding CancelStrictCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{l:T ConfirmEnd}" Margin="10,0,0,0" Command="{Binding ConfirmStrictCommand}" IsEnabled="{Binding StrictCanConfirm}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Viewbox>

                    <!-- 底部统计 -->
                    <UniformGrid Grid.Row="3" Columns="4" Margin="0,24,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="{l:T StatApps}" Style="{StaticResource Faint}" />
                                <TextBlock Text="{Binding AppsCount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="{l:T StatSites}" Style="{StaticResource Faint}" />
                                <TextBlock Text="{Binding SitesCount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="{l:T StatFolders}" Style="{StaticResource Faint}" />
                                <TextBlock Text="{Binding FoldersCount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- 扩展状态卡片：点击打开安装向导 -->
                        <Button Margin="8,0,0,0" Command="{Binding OpenExtensionSetupCommand}" ToolTip="{l:T StatExtensionTip}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Style="{StaticResource Card}" Padding="18,14">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                                    <TextBlock Text="{l:T StatExtension}" Style="{StaticResource Faint}" />
                                </DockPanel>
                                <TextBlock Text="{Binding ExtensionStatus}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ExtensionStatus}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <!-- ======================= 应用 ======================= -->
            <TabItem Header="{l:T NavApps}" Tag="&#xE71D;" Style="{StaticResource NavItem}">
                <Grid Margin="44,52,44,28" DataContext="{Binding Apps}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                Command="{Binding DataContext.OpenSmartBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{l:T SmartBlock}" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{l:T NavApps}" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Dim}" Margin="0,6,24,0" TextWrapping="Wrap" Text="{l:T AppsIntro}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,20,0,0" LastChildFill="False">
                        <TextBox DockPanel.Dock="Left" Width="280" Tag="{l:T AppsSearch}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <Button DockPanel.Dock="Right" Content="{l:T AddProgram}" Margin="10,0,0,0" Command="{Binding AddManualCommand}" />
                        <Button DockPanel.Dock="Right" Content="{l:T Rescan}" Command="{Binding ScanCommand}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStatus}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    </DockPanel>

                    <!-- 分类筛选 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,14">
                        <RadioButton Style="{StaticResource Segment}" GroupName="appfilter" IsChecked="{Binding FilterAll}">
                            <TextBlock><Run Text="{l:T FilterAll}" /><Run Text="  " /><Run Text="{Binding CountAll, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="appfilter" IsChecked="{Binding FilterApps}">
                            <TextBlock><Run Text="{l:T FilterApps}" /><Run Text="  " /><Run Text="{Binding CountApps, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="appfilter" IsChecked="{Binding FilterGames}">
                            <TextBlock><Run Text="{l:T FilterGames}" /><Run Text="  " /><Run Text="{Binding CountGames, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="appfilter" IsChecked="{Binding FilterBlocked}">
                            <TextBlock><Run Text="{l:T FilterBlocked}" /><Run Text="  " /><Run Text="{Binding BlockedCount, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="appfilter" IsChecked="{Binding FilterSystem}" ToolTip="{l:T FilterSystemTip}">
                            <TextBlock><Run Text="{l:T FilterSystem}" /><Run Text="  " /><Run Text="{Binding CountSystem, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" /></TextBlock>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding View}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="38" Height="38">
                                            <Border CornerRadius="10" Background="{DynamicResource SubtleBrush}">
                                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <!-- 整个游戏目录 -->
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource LongBreakBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-3,-3" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="9" Foreground="White" HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource SubtleBrush}" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Center"
                                                ToolTip="{Binding SourceTip}">
                                            <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                                        </Border>
                                        <!-- ToolTipService.ShowOnDisabled：禁用时也能看到原因 -->
                                        <Border Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center" Background="Transparent"
                                                ToolTip="{Binding StrongTip}" ToolTipService.ShowOnDisabled="True">
                                            <CheckBox Style="{StaticResource Chip}" Content="{l:T Strong}" IsChecked="{Binding IsStrong}" IsEnabled="{Binding CanStrong}" />
                                        </Border>
                                        <Border Grid.Column="4" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding BlockReason}" ToolTipService.ShowOnDisabled="True">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsBlocked}" IsEnabled="{Binding CanBlock}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= 网站 ======================= -->
            <TabItem Header="{l:T NavSites}" Tag="&#xE774;" Style="{StaticResource NavItem}">
                <Grid Margin="44,52,44,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="350" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Command="{Binding OpenSmartBlockCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{l:T SmartBlock}" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{l:T NavSites}" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Dim}" Margin="0,6,24,0" TextWrapping="Wrap" Text="{l:T SitesIntro}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,16,0" DataContext="{Binding Sites}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T Add}" Margin="10,0,0,0" Command="{Binding AddCommand}" IsDefault="True" />
                                <TextBox Tag="{l:T SitesInput}" Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource WarnBrush}" FontSize="12" Margin="4,6,0,0" />
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" Margin="-6,6,-6,-6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource FocusSoftBrush}">
                                                <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource FocusBrush}" FontWeight="SemiBold" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Domain}" FontSize="14" />
                                                <TextBlock Style="{StaticResource Faint}" Margin="0,2,0,0">
                                                    <Run Text="{l:T SitesSubdomains}" /><Run Text="{Binding Domain, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Style="{StaticResource CaptionButton}" Width="34" Height="34" Margin="10,0,0,0" FontSize="13"
                                                    Content="&#xE74D;" ToolTip="{l:T Delete}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- 扩展安装指引 -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExtensionConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource BreakBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ExtensionStatus}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Sites.Connections}" Margin="18,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Faint}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 安装向导入口 -->
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Stretch" Command="{Binding OpenExtensionSetupCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA86;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T SitesInstallButton}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{l:T SitesInstallHint}" Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0" />

                            <TextBlock Text="{l:T ExtInstallTitle}" Style="{StaticResource H2}" FontSize="14" Margin="0,24,0,12" />
                            <StackPanel DataContext="{Binding Sites}">
                                <StackPanel.Resources>
                                    <Style x:Key="StepNo" TargetType="Border">
                                        <Setter Property="Width" Value="22" />
                                        <Setter Property="Height" Value="22" />
                                        <Setter Property="CornerRadius" Value="11" />
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                    </Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </StackPanel.Resources>
                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepNo}"><TextBlock Text="1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel>
                                        <TextBlock Text="{l:T ExtStep1}" />
                                        <Button Content="{l:T CopyAddress}" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="12,5" Command="{Binding CopyExtensionsUrlCommand}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepNo}"><TextBlock Text="2" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Text="{l:T ExtStep2}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepNo}"><TextBlock Text="3" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel>
                                        <TextBlock Text="{l:T ExtStep3}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="{l:T OpenFolder}" Padding="12,5" Command="{Binding OpenExtensionFolderCommand}" />
                                            <Button Content="{l:T CopyPath}" Padding="12,5" Margin="8,0,0,0" Command="{Binding CopyFolderPathCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource StepNo}"><TextBlock Text="4" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Text="{l:T ExtStep4}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,16,0,0">
                                    <Run Text="{l:T ExtensionIdLabel}" /><Run Text="{Binding ExtensionId, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= 文件夹 ======================= -->
            <TabItem Header="{l:T NavFolders}" Tag="&#xE8B7;" Style="{StaticResource NavItem}">
                <Grid Margin="44,52,44,28" DataContext="{Binding Folders}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T AddFolder}" VerticalAlignment="Bottom" Command="{Binding AddCommand}" />
                        <StackPanel>
                            <TextBlock Text="{l:T NavFolders}" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Dim}" Margin="0,6,24,0" TextWrapping="Wrap" Text="{l:T FoldersIntro}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource WarnSoftBrush}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="17"
                                                           Foreground="{DynamicResource WarnBrush}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Faint}" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource BreakSoftBrush}" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Center"
                                                    Visibility="{Binding AllowedThisRound, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:T AllowedThisRound}" FontSize="11" Foreground="{DynamicResource BreakBrush}" />
                                            </Border>
                                            <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Style="{StaticResource CaptionButton}" Width="34" Height="34" Margin="10,0,0,0" FontSize="13"
                                                    Content="&#xE74D;" ToolTip="{l:T Delete}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 空列表提示 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="34"
                                           Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{l:T FoldersEmpty}" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="{l:T FoldersEmptyHint}" Style="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="{DynamicResource WarnBrush}" FontSize="12"
                               VerticalAlignment="Bottom" Margin="16,0,0,12" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <!-- ======================= 设置 ======================= -->
            <TabItem Header="{l:T NavSettings}" Tag="&#xE713;" Style="{StaticResource NavItem}">
                <Grid DataContext="{Binding Settings}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="44,52,44,24" MaxWidth="780" HorizontalAlignment="Left">
                            <StackPanel.Resources>
                                <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Width" Value="76" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="RowLabel" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Style>
                                <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Margin" Value="0,0,0,16" />
                                </Style>
                                <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="50,4,0,0" />
                                </Style>
                            </StackPanel.Resources>

                            <TextBlock Text="{l:T NavSettings}" Style="{StaticResource H1}" Margin="0,0,0,20" />

                            <!-- 番茄钟 -->
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="{l:T NavPomodoro}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{l:T SetFocusMinutes}" Style="{StaticResource Faint}" Margin="0,0,0,6" />
                                            <TextBox Style="{StaticResource NumBox}" HorizontalAlignment="Left" Text="{Binding FocusMinutes}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{l:T SetShortBreak}" Style="{StaticResource Faint}" Margin="0,0,0,6" />
                                            <TextBox Style="{StaticResource NumBox}" HorizontalAlignment="Left" Text="{Binding ShortBreakMinutes}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{l:T SetLongBreak}" Style="{StaticResource Faint}" Margin="0,0,0,6" />
                                            <TextBox Style="{StaticResource NumBox}" HorizontalAlignment="Left" Text="{Binding LongBreakMinutes}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{l:T SetRounds}" Style="{StaticResource Faint}" Margin="0,0,0,6" />
                                            <TextBox Style="{StaticResource NumBox}" HorizontalAlignment="Left" Text="{Binding RoundsBeforeLongBreak}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox Style="{StaticResource Switch}" Content="{l:T SetAutoNext}" Margin="0,18,0,0" IsChecked="{Binding AutoStartNextFocus}" />
                                </StackPanel>
                            </Border>

                            <!-- 拦截 -->
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="{l:T SetBlocking}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:T SetGraceBefore}" Style="{StaticResource RowLabel}" />
                                        <TextBox Style="{StaticResource NumBox}" Margin="10,0" Text="{Binding CloseGraceSeconds}" />
                                        <TextBlock Text="{l:T SetGraceAfter}" Style="{StaticResource RowLabel}" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" Content="{l:T SetStrict}" Margin="0,20,0,0" IsChecked="{Binding StrictMode}" />
                                    <TextBlock Style="{StaticResource Note}" Text="{l:T SetStrictNote}" />
                                    <StackPanel Orientation="Horizontal" Margin="50,10,0,0">
                                        <TextBlock Text="{l:T SetCooldown}" Style="{StaticResource RowLabel}" />
                                        <TextBox Style="{StaticResource NumBox}" Margin="10,0" Text="{Binding StrictUnlockSeconds}" />
                                        <TextBlock Text="{l:T Seconds}" Style="{StaticResource RowLabel}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 强力模式 -->
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="{l:T SetStrongTitle}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="{l:T SetStrongNote}" />
                                    <TextBlock Text="{Binding ResidueText}" Style="{StaticResource Faint}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{l:T RestartAsAdmin}" Margin="0,0,10,0"
                                                Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVis}}" Command="{Binding RestartAsAdminCommand}" />
                                        <Button Content="{l:T CleanStrong}" Command="{Binding CleanResidueCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 浏览器守护 -->
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="{l:T SetGuardTitle}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                    <CheckBox Style="{StaticResource Switch}" Content="{l:T SetGuardSwitch}" IsChecked="{Binding GuardBrowsers}" />
                                    <TextBlock Style="{StaticResource Note}" Text="{l:T SetGuardNote}" />
                                    <ItemsControl ItemsSource="{Binding GuardedBrowsers}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Background="{DynamicResource SubtleBrush}" Padding="12,6" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="28" Height="28" Content="&#xE8BB;" ToolTip="{l:T Remove}"
                                                                Command="{Binding DataContext.RemoveBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{l:T AddHelium}" Command="{Binding AddHeliumCommand}" />
                                        <Button Content="{l:T AddBrowser}" Margin="10,0,0,0" Command="{Binding AddBrowserCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 提醒 -->
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="{l:T SetReminders}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                    <CheckBox Style="{StaticResource Switch}" Content="{l:T SetSound}" IsChecked="{Binding SoundEnabled}" />
                                    <CheckBox Style="{StaticResource Switch}" Content="{l:T SetOverlay}" Margin="0,14,0,0" IsChecked="{Binding OverlayEnabled}" />
                                    <StackPanel Orientation="Horizontal" Margin="50,12,0,0">
                                        <TextBlock Text="{l:T SetPosition}" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="{l:T CornerTL}" IsChecked="{Binding CornerTopLeft}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="{l:T CornerTR}" IsChecked="{Binding CornerTopRight}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="{l:T CornerBL}" IsChecked="{Binding CornerBottomLeft}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="corner" Content="{l:T CornerBR}" IsChecked="{Binding CornerBottomRight}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="50,12,0,0">
                                        <TextBlock Text="{l:T SetOpacity}" Style="{StaticResource RowLabel}" Margin="0,0,12,0" />
                                        <Slider Width="200" Minimum="0.2" Maximum="1" Value="{Binding OverlayOpacity}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" Style="{StaticResource Faint}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 其它 -->
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="{l:T SetOther}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                    <CheckBox Style="{StaticResource Switch}" Content="{l:T SetAutoStart}" IsChecked="{Binding AutoStart}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <TextBlock Text="{l:T SetPort}" Style="{StaticResource RowLabel}" />
                                        <TextBox Style="{StaticResource NumBox}" Margin="10,0" Text="{Binding BridgePort}" />
                                        <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center">
                                            <Run Text="{l:T ExtensionIdLabel}" /><Run Text="{Binding ExtensionId, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 固定在底部的保存栏 -->
                    <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="44,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="{l:T SaveSettings}" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding SavedText}" Foreground="{DynamicResource BreakBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 标题栏按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="{l:T Minimize}" />
            <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="{l:T Maximize}" />
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="{l:T HideToTray}" />
        </StackPanel>
    </Grid>
</Window>
