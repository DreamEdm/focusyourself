<Window x:Class="FocusYourself.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        FontFamily="{StaticResource UiFont}">
    <!-- 半透明胶囊：彩色圆点 + 阶段 + 倒计时 + 底部细进度线 -->
    <Border Margin="10" CornerRadius="18" Background="{DynamicResource OverlayBgBrush}" BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1" Padding="14,8,16,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock x:Name="PhaseText" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="TimeText" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Height="2" Margin="0,6,0,0">
                <Border Background="{DynamicResource RingTrackBrush}" CornerRadius="1" />
                <Border x:Name="Bar" HorizontalAlignment="Left" CornerRadius="1" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
