<Window x:Class="FocusYourself.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Width="380" SizeToContent="Height" FontFamily="{StaticResource UiFont}" Opacity="0">
    <Border x:Name="Card" Margin="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Cursor="Hand" MouseLeftButtonUp="OnCardClick">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="{DynamicResource ShadowOpacity}" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="60" />
        </Border.RenderTransform>
        <Grid>
            <!-- 左侧彩色强调条 -->
            <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" CornerRadius="1.5" Margin="8,18,0,18" />
            <Grid Margin="20,16,14,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" VerticalAlignment="Top">
                    <Ellipse x:Name="IconBg" Opacity="0.18" />
                    <TextBlock x:Name="IconGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CaptionButton}" Width="28" Height="28" Content="&#xE8BB;"
                        VerticalAlignment="Top" Click="OnCloseClick" />
            </Grid>
            <!-- 底部剩余显示时间 -->
            <Border x:Name="Life" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,16,1" CornerRadius="1" Opacity="0.6" />
        </Grid>
    </Border>
</Window>
