{
  "manifest_version": 3,
  "name": "FocusYourself",
  "version": "1.2.0",
  "description": "与 FocusYourself 桌面端联动：专注期间屏蔽指定网站，休息时自动解除。",
  "key": "",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FocusYourself",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js", "shared.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "incognito": "spanning"
}
